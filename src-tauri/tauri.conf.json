{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地AI助手",
  "version": "0.1.0",
  "identifier": "com.yg.localaihelper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "本地 AI 助手",
        "width": 1000,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0f1115",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/hardware.ps1": "hardware.ps1",
      "../assets/runtime/*": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi"
      }
    }
  }
}
